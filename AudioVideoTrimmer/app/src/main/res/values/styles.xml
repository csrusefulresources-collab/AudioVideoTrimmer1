<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Large touch targets (≥ 56dp) and readable text for every button -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="strokeColor">@color/button_stroke_filled</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="strokeColor">@color/button_stroke_filled</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/button_stroke_outlined</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="TextAppearance.App.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.App.Button.Compact" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/button_stroke_outlined</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="TextAppearance.App.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.App.Button.Main" parent="Widget.Material3.Button.TextButton">
        <item name="strokeColor">@color/button_stroke_filled</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
    </style>
</resources>
